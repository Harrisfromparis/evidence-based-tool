# Evidence-Based Tool – FastMCP server environment variables
#
# Copy this file to .env and fill in the values before running the server.
# Never commit .env to source control.

# ------------------------------------------------------------------
# Required
# ------------------------------------------------------------------

# Deployment-level API key.  All MCP tool calls must supply this key.
# Generate a secure random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=replace-me-with-a-secure-random-key

# ------------------------------------------------------------------
# Optional
# ------------------------------------------------------------------

# Port the uvicorn server listens on (default: 8000)
# PORT=8000

# Set to "development" to enable verbose error output
# ENVIRONMENT=production
