{
  "fontFamilies": {
    "primary": {
      "name": "Inter",
      "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "usage": "Body text, UI elements, general content"
    },
    "display": {
      "name": "Merriweather",
      "fallback": "Georgia, serif",
      "usage": "Page titles, section headers, major headings"
    }
  },
  "fontWeights": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "fontSizes": {
    "h1": {
      "size": "32px",
      "lineHeight": 1.2,
      "letterSpacing": "-0.02em",
      "weight": 700,
      "family": "display"
    },
    "h2": {
      "size": "24px",
      "lineHeight": 1.3,
      "letterSpacing": "-0.01em",
      "weight": 700,
      "family": "display"
    },
    "h3": {
      "size": "18px",
      "lineHeight": 1.4,
      "letterSpacing": "0",
      "weight": 600,
      "family": "primary"
    },
    "body": {
      "size": "16px",
      "lineHeight": 1.6,
      "letterSpacing": "0.01em",
      "weight": 400,
      "family": "primary"
    },
    "caption": {
      "size": "14px",
      "lineHeight": 1.5,
      "letterSpacing": "0.01em",
      "weight": 400,
      "family": "primary"
    },
    "button": {
      "size": "16px",
      "weight": 500,
      "family": "primary"
    },
    "label": {
      "size": "14px",
      "weight": 500,
      "family": "primary"
    }
  },
  "accessibility": {
    "minimumSize": "14px",
    "recommendedBodySize": "16px",
    "minimumLineHeight": 1.5,
    "notes": "Never use text smaller than 14px. 16px is recommended for body text. Maintain line height of at least 1.5 for body text."
  }
}
